{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Mantix development (Clang 23)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Mantix sanitizers (Clang 23)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "MANTIX_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Mantix benchmarks (Clang 23 Release)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "MANTIX_BUILD_EXAMPLES": "OFF",
        "MANTIX_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "targets": [
        "mantix_bench"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
